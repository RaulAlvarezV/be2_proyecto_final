{
  "info": {
    "name": "Plataforma de Torneos y Clínicas de Hockey",
    "description": "Flujo completo de la entrega final. Requiere el servidor en marcha y los datos de prueba cargados con npm run seed. Se puede correr completa con el Runner de Postman: cada pedido tiene sus verificaciones en la pestaña Scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"eventDate\", new Date(Date.now() + 30 * 24 * 3600 * 1000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "newEmail",
      "value": ""
    },
    {
      "key": "eventDate",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "adminEventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registro, login, current y logout",
      "item": [
        {
          "name": "Registro de un usuario nuevo → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email distinto en cada corrida, así la colección se puede ejecutar varias veces",
                  "pm.collectionVariables.set(\"newEmail\", `jugador${Date.now()}@mail.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"la respuesta no incluye password\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.test(\"se registra con rol user\", () => pm.expect(pm.response.json().payload.role).to.eql(\"user\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Tomás\",\n  \"last_name\": \"Díaz\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Tomas2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base}}/sessions/register"
          }
        },
        {
          "name": "Login del usuario nuevo → 200 (cookie currentUser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"setea la cookie currentUser\", () => pm.expect(pm.cookies.has(\"currentUser\")).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Tomas2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base}}/sessions/login"
          }
        },
        {
          "name": "Current → 200 sin password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"la respuesta no incluye password\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.test(\"devuelve id, email y role\", () => pm.expect(Object.keys(pm.response.json().payload)).to.eql([\"id\", \"email\", \"role\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/sessions/current"
          }
        },
        {
          "name": "Logout → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base}}/sessions/logout"
          }
        },
        {
          "name": "Current después del logout → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/sessions/current"
          }
        }
      ]
